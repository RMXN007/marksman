# 4. Training Datasets, Raw Images, Labels & Backups
# Raw/processed image datasets and bounding-box text files must NOT be in GitHub
backend/dataset/images/
backend/dataset/labels/
backend/dataset/checked data/
backend/dataset/labels_heuristic_backup/
Marksman Training Data/
Marksman Training Data.7z
*.7z
*.zip
*.tar.gz

# 5. Annotation Workspaces & Audits
project_workspace/
launch_label_studio.bat

# 6. Training Checkpoints, Temporary Runs & Weights
# Standalone untracked weights and caches
yolov8s.pt
weights/
backend/training/smoke_test.py
backend/training/resume_training.py

# Bulk runs directory: ignore all runs except the primary experiment model weights
/runs/
backend/runs/*
!backend/runs/experiment_01_yolov8s_640/
backend/runs/experiment_01_yolov8s_640/*
!backend/runs/experiment_01_yolov8s_640/weights/
backend/runs/experiment_01_yolov8s_640/weights/*
!backend/runs/experiment_01_yolov8s_640/weights/best.pt
!backend/runs/experiment_01_yolov8s_640/results.csv

